      ]
    },
    "approved_for_hydration": {
      "safe_actions": [
        "hydrate_task"
      ],
      "blocked": [
        "different_candidate",
        "different_write_path"
      ]
    },
    "hydrated_not_delivered": {
      "safe_actions": [
        "stop",
        "delivery_gate"
      ],
      "blocked": [
        "repeat_hydration"
      ]
    },
    "fulfilled_or_stale": {
