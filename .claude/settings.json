{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "LS",
      "WebFetch",
      "WebSearch",
      "Agent"
    ],
    "deny": [
      "Edit(kernel/**)",
      "Bash(rm -rf *)",
      "Bash(git push --force)",
      "Bash(git reset --hard HEAD~)"
    ]
  },
  "env": {
"AZOTH_VERSION": "0.1.4.16",
"AZOTH_PHASE": "4",
    "CLAUDE_CODE_EFFORT_LEVEL": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/edit_pretooluse_orchestrator.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/pip-install-guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/posttooluse_terminal_filter.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/session_start_welcome.py",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
