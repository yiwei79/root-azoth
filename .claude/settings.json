{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "List",
      "WebFetch",
      "WebSearch",
      "Task"
    ],
    "deny": [
      "Edit(kernel/**)",
      "Bash(rm -rf *)",
      "Bash(git push --force)",
      "Bash(git reset --hard HEAD~)",
      "Bash(pip install)*without*requirements",
      "Edit(.claude/settings.json)"
    ]
  },
  "env": {
    "AZOTH_VERSION": "0.1.0-dev",
    "AZOTH_PHASE": "3"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "type": "command",
        "command": "python3 /Users/yiwei/GithubRepos/root-azoth/.claude/hooks/scope-gate.py"
      }
    ]
  }

  
}
