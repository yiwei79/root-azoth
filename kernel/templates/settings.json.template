{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "List",
      "WebFetch",
      "WebSearch",
      "Task"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force)",
      "Bash(git reset --hard HEAD~)",
      "Edit(kernel/**)",
      "Edit(.claude/settings.json)"
    ]
  },
  "env": {
    "AZOTH_VERSION": "{{AZOTH_VERSION}}",
    "AZOTH_PHASE": "operate"
  }
}
