{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/session_start_welcome.py\"",
            "timeout": 120,
            "statusMessage": "Loading Azoth orientation"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/user_prompt_submit_router.py\"",
            "statusMessage": "Routing Azoth workflow prompt"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/posttooluse_terminal_filter.py\"",
            "statusMessage": "Filtering terminal output"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/kernel-integrity.py\"",
            "timeout": 10,
            "statusMessage": "Validating kernel integrity"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/notify.py\" --title \"Azoth\" --message \"Codex session waiting for input\" --quiet",
            "timeout": 30,
            "statusMessage": "Sending Azoth notification"
          }
        ]
      }
    ]
  }
}
